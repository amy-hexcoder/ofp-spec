{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofp.dev/schemas/0.3/error.schema.json",
  "title": "OFP error",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["invalid_request", "invalid_body", "site_not_found", "not_accepting", "no_settled_sites",
            "currency_mismatch", "amount_out_of_range", "too_many_domains", "insufficient_balance",
            "signature_invalid", "key_unknown", "operator_unverified", "limit_exceeded", "payment_provider_error"]
        },
        "message": { "type": "string" }
      }
    }
  }
}
